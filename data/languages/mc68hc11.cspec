<!--
  The MC68HC11 has no standard ABI.  This is what GCC's m68hc11 port does (checked with the
  GCC 3.4.6 compiler): the first argument goes in D when it is 1 or 2 bytes (a char in B) and in
  X:D when it is 4 bytes (X holds the high half); all other arguments are pushed, the first one
  at the lowest address; results come back in D or X:D.  The soft registers (_.d1 ... _.frame)
  live in the zero page and are linker-assigned, so they are not described here.
-->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <pointer_size value="2"/>
    <wchar_size value="2"/>
    <short_size value="2"/>
    <integer_size value="4"/>   <!-- GCC default; -mshort makes int 2 bytes -->
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="4"/>
    <long_double_size value="8"/>
  </data_organization>
  <global>
    <range space="RAM"/>
  </global>
  <stackpointer register="S" space="RAM" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="1" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__gcc" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2" extension="inttype">
          <register name="D"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="X" piece2="D"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="1">
          <addr offset="3" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2" extension="inttype">
          <register name="D"/>
        </pentry>
        <pentry minsize="3" maxsize="4">
          <addr space="join" piece1="X" piece2="D"/>
        </pentry>
      </output>
      <unaffected>
        <register name="S"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
